VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# auto | service | marketplace | staff
VITE_SITE_MODE=auto

# Supabase Edge Functions / booking email notifications
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
ADMIN_BOOKING_EMAIL=info@example.com
BOOKING_FROM_EMAIL=STM Motors <bookings@example.com>
PUBLIC_WEBSITE_URL=https://example.com

# Fixaroo parts pricing (Supabase Edge Function secrets; never VITE_ prefixed)
FIXAROO_PRICING_ENABLED=false
FIXAROO_API_KEY=fxr_your_api_key
FIXAROO_LABOUR_PRICE=40

# Contact form emails + Google reCAPTCHA
CONTACT_FORM_TO_EMAIL=info@stmmotors.com
CONTACT_FORM_FROM_EMAIL=STM Motors <info@stmmotors.com>
CONTACT_RECAPTCHA_SECRET=your-google-recaptcha-secret
VITE_RECAPTCHA_SITE_KEY=your-google-recaptcha-site-key
